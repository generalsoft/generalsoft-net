---
// Contact Section
---

<section id="contact" class="section-padding bg-white">
  <div class="container-narrow">
    <div class="grid lg:grid-cols-2 gap-16">
      <!-- Left: Info -->
      <div class="reveal">
        <span class="section-label">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
          </svg>
          Get in Touch
        </span>
        <h2 class="section-title mb-6">
          Let's talk about your
          <span class="gradient-text">next project</span>
        </h2>
        <p class="section-subtitle mb-10">
          Whether you're looking for AI courses for your school or custom software for your business — we'd love to hear from you.
        </p>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900 mb-1">Email</h4>
              <a href="mailto:info@generalsoft.net" class="text-brand-600 hover:text-brand-700 transition-colors">info@generalsoft.net</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900 mb-1">Location</h4>
              <p class="text-slate-500">Dubai</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900 mb-1">Business Hours</h4>
              <p class="text-slate-500">Sunday – Thursday, 9:00 AM – 6:00 PM (GST)</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="reveal reveal-delay-2">
        <form class="card p-8 lg:p-10" id="contact-form">
          <div class="space-y-5">
            <div>
              <label for="name" class="block text-sm font-medium text-slate-700 mb-2">Full Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900
                       focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent
                       placeholder:text-slate-400 transition-all"
                placeholder="Your name"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-slate-700 mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900
                       focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent
                       placeholder:text-slate-400 transition-all"
                placeholder="you@example.com"
              />
            </div>

            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="phone" class="block text-sm font-medium text-slate-700 mb-2">
                  Phone Number
                  <span class="ml-1 text-xs font-normal text-slate-400">(optional)</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  autocomplete="tel"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900
                         focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent
                         placeholder:text-slate-400 transition-all"
                  placeholder="+971 50 123 4567"
                />
              </div>

              <div>
                <label for="company" class="block text-sm font-medium text-slate-700 mb-2">
                  Company Name
                  <span class="ml-1 text-xs font-normal text-slate-400">(optional)</span>
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  autocomplete="organization"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900
                         focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent
                         placeholder:text-slate-400 transition-all"
                  placeholder="Your company"
                />
              </div>
            </div>

            <div>
              <label for="interest" class="block text-sm font-medium text-slate-700 mb-2">I'm interested in</label>
              <select
                id="interest"
                name="interest"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900
                       focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent
                       transition-all"
              >
                <option value="">Select an option</option>
                <option value="ai-courses-school">AI Courses — for my school</option>
                <option value="ai-courses-student">AI Courses — as a student</option>
                <option value="custom-software">Custom Software Development</option>
                <option value="consulting">IT Consulting & Systems Analysis</option>
                <option value="other">Something else</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-slate-700 mb-2">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900
                       focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent
                       placeholder:text-slate-400 transition-all resize-none"
                placeholder="Tell us about your project or what you're looking for..."
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full justify-center">
              <span class="btn-label inline-flex items-center gap-2">
                Send Message
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </span>
            </button>

            <p
              id="contact-form-status"
              role="status"
              aria-live="polite"
              class="hidden text-sm font-medium"
            ></p>
          </div>
        </form>

        <script>
          // The config check is tiny; the Firebase SDK itself is loaded on demand.
          import { isFirebaseConfigured } from '../lib/firebase-config';

          const form = document.getElementById('contact-form') as HTMLFormElement | null;
          const statusEl = document.getElementById('contact-form-status');
          const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;

          const BUTTON_CONTENT = {
            idle: `
              <span class="btn-label inline-flex items-center gap-2">
                Send Message
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </span>
            `,
            sending: `
              <span class="btn-label inline-flex items-center gap-2">
                <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                Sending...
              </span>
            `,
            sent: `
              <span class="btn-label inline-flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Message Sent!
              </span>
            `,
          };

          function setButtonState(state: keyof typeof BUTTON_CONTENT) {
            if (!submitButton) return;
            submitButton.innerHTML = BUTTON_CONTENT[state];
            submitButton.disabled = state === 'sending';
            submitButton.classList.toggle('bg-accent-600', state === 'sent');
            submitButton.classList.toggle('hover:bg-accent-700', state === 'sent');
            submitButton.classList.toggle('bg-brand-600', state !== 'sent');
            submitButton.classList.toggle('cursor-not-allowed', state === 'sending');
            submitButton.classList.toggle('opacity-80', state === 'sending');
          }

          function showStatus(message: string, type: 'success' | 'error') {
            if (!statusEl) return;
            statusEl.textContent = message;
            statusEl.classList.remove('hidden', 'text-accent-700', 'text-red-600');
            statusEl.classList.add(type === 'success' ? 'text-accent-700' : 'text-red-600');
          }

          function hideStatus() {
            if (!statusEl) return;
            statusEl.textContent = '';
            statusEl.classList.add('hidden');
          }

          function fieldValue(data: FormData, key: string): string {
            const value = data.get(key);
            return typeof value === 'string' ? value : '';
          }

          form?.addEventListener('submit', async (event) => {
            event.preventDefault();
            hideStatus();

            const data = new FormData(form);
            const payload = {
              name: fieldValue(data, 'name'),
              email: fieldValue(data, 'email'),
              phone: fieldValue(data, 'phone'),
              company: fieldValue(data, 'company'),
              interest: fieldValue(data, 'interest'),
              message: fieldValue(data, 'message'),
            };

            if (!payload.name.trim() || !payload.email.trim() || !payload.message.trim()) {
              showStatus('Please fill in your name, email and message before sending.', 'error');
              return;
            }

            if (!isFirebaseConfigured) {
              showStatus(
                'Sorry, the contact form is temporarily unavailable. Please email us at info@generalsoft.net.',
                'error'
              );
              return;
            }

            setButtonState('sending');

            try {
              // Load the Firebase SDK only when it is actually needed.
              const { submitContactMessage } = await import('../lib/firebase');
              await submitContactMessage(payload);
              form.reset();
              setButtonState('sent');
              showStatus(
                "Thanks for reaching out! Your message has been sent — we'll get back to you within one business day.",
                'success'
              );
            } catch (error) {
              console.error('[contact-form] Failed to send message:', error);
              setButtonState('idle');
              showStatus(
                'Something went wrong while sending your message. Please try again, or email us at info@generalsoft.net.',
                'error'
              );
            }
          });
        </script>
      </div>
    </div>
  </div>
</section>
