---
// Footer
---

<footer class="bg-slate-900 text-slate-400">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <!-- Main Footer -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 py-16">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-lg bg-brand-600 flex items-center justify-center">
            <span class="text-white font-bold">G</span>
          </div>
          <span class="font-bold text-white">Generalsoft</span>
        </div>
        <p class="text-sm leading-relaxed mb-4">
          Education & Training Computer Software. Licensed in mainland Dubai.
        </p>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Services</h4>
        <ul class="space-y-3">
          <li><a href="#ai-courses" class="text-sm hover:text-white transition-colors">AI Courses</a></li>
          <li><a href="#custom-software" class="text-sm hover:text-white transition-colors">Custom Software</a></li>
          <li><a href="#custom-software" class="text-sm hover:text-white transition-colors">Mobile Apps</a></li>
          <li><a href="#custom-software" class="text-sm hover:text-white transition-colors">IT Consulting</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Company</h4>
        <ul class="space-y-3">
          <li><a href="#about" class="text-sm hover:text-white transition-colors">About Us</a></li>
          <li><a href="#contact" class="text-sm hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Legal</h4>
        <ul class="space-y-3">
          <li><a href="#" class="text-sm hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="text-sm hover:text-white transition-colors">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-slate-800 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm">
        &copy; {new Date().getFullYear()} Generalsoft For Education & Training Computer Software. All rights reserved.
      </p>
      <div class="flex items-center gap-2 text-sm">
        <svg class="w-4 h-4 text-accent-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
        </svg>
        Dubai
      </div>
    </div>
  </div>
</footer>
