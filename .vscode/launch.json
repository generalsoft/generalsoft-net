{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Astro: server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Astro: client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4321",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Astro: full stack",
      "configurations": ["Astro: server", "Astro: client (Chrome)"]
    }
  ]
}